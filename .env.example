# This MVP runs in public-data / paper-trading mode by default.
PAPER_TRADING_ONLY=true
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
MAX_MARKETS=50
REFRESH_SECONDS=10
BANKROLL_DOLLARS=1000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0

# Leave live credentials empty until paper trading has proved useful.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Optional Supabase sink for cloud dashboards.
# Use a service-role key only on your local machine/VPS monitor, never in browser code.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_HISTORY_INTERVAL_SECONDS=300
SUPABASE_RETENTION_DAYS=14
SUPABASE_CLEANUP_INTERVAL_SECONDS=3600
